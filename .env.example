# Clé créée dans Google AI Studio : https://aistudio.google.com/apikey
# Lue uniquement par le serveur. Ne jamais utiliser NEXT_PUBLIC_GEMINI_API_KEY.
GEMINI_API_KEY=

# Modèle Gemma appelé via la Gemini API. Ce n'est pas un modèle Gemini.
GEMMA_MODEL=gemma-4-26b-a4b-it

# Optionnel. S'il est défini, POST /api/analyze exige l'en-tête x-demo-access.
# Ne pas commiter la valeur réelle.
DEMO_ACCESS_TOKEN=

# Optionnel. URL publique de l'app (allowlist Origin), ex. https://….ondigitalocean.app
PUBLIC_APP_URL=

